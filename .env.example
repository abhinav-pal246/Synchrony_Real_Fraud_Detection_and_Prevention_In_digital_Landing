# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# docker-compose reads .env automatically. Defaults are safe for local dev.

# ── PostgreSQL ──
POSTGRES_USER=synchrony
POSTGRES_PASSWORD=synchrony
POSTGRES_DB=synchrony
DATABASE_URL=postgresql://synchrony:synchrony@postgres:5432/synchrony

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Kafka ──
# Inside the docker network use "kafka:9092".
# From your host machine (e.g. a script), use "localhost:29092".
KAFKA_BOOTSTRAP=kafka:9092

# ── Security (JWT) ──
# Generate a real secret:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_SECONDS=3600
# The analyst login is NOT configured here. Create it (bcrypt-hashed into the
# Postgres users table) after the stack is up:
#   docker compose exec backend python -m scripts.seed_user "you@example.com" "your-password"

# ── AI (AWS Bedrock — optional; falls back to a template if unavailable) ──
# Credentials come from your host ~/.aws (mounted read-only by docker-compose).
# Note: Anthropic Claude may require AWS account verification; the model below
# works without it on this project's account.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0
