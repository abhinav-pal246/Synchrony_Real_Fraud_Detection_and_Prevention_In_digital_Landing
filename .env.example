# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# docker-compose reads .env automatically. Defaults are safe for local dev.

# ── PostgreSQL ──
POSTGRES_USER=synchrony
POSTGRES_PASSWORD=synchrony
POSTGRES_DB=synchrony
DATABASE_URL=postgresql://synchrony:synchrony@postgres:5432/synchrony

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Kafka ──
# Inside the docker network use "kafka:9092".
# From your host machine (e.g. a script), use "localhost:29092".
KAFKA_BOOTSTRAP=kafka:9092

# ── Security (JWT + demo analyst login) ──
# Generate a real secret:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_SECONDS=3600
# Analyst login. Store only the bcrypt HASH of the password (never plaintext):
#   docker compose run --rm backend python -c "import bcrypt;print(bcrypt.hashpw(b'YOURPASS',bcrypt.gensalt()).decode())"
DEMO_USER_EMAIL=analyst@example.com
DEMO_USER_PASSWORD_HASH=

# ── AI (AWS Bedrock — optional; falls back to a template if unavailable) ──
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
